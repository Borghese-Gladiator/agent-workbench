{
  "name": "agentic-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "pnpm -r --filter='./packages/**' --filter='./apps/**' --filter='./workers/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "report:tokens": "tsx scripts/token-usage-report.ts",
    "audit:docs": "scripts/audit-docs.sh"
  },
  "devDependencies": {
    "@awb/config": "workspace:*",
    "@awb/database": "workspace:*",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@swc/core",
      "protobufjs",
      "esbuild"
    ]
  }
}
