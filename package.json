{
  "name": "agent-workbench",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "bin": { "awb": "packages/cli/bin/awb" },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning 'packages/*/test/*.test.ts'",
    "e2e": "node --test --disable-warning=ExperimentalWarning 'e2e/*.e2e.ts'",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
