#!/usr/bin/env bash
#
# pre-push — block pushes that don't build or don't pass the test suite.
#
# This repo has no CI. Nothing runs on a PR and nothing runs on main, so the
# push is the last moment a broken tree can be caught before it becomes some
# other checkout's problem. Build + test is too slow for pre-commit (which
# stays at the millisecond docs audit), but once per push is the right price.
#
# Bypass in an emergency with:  git push --no-verify
# Or for a single push:         AWB_SKIP_PREPUSH=1 git push
#
# Installed via `git config core.hooksPath .githooks`, which the package.json
# `prepare` script sets on `pnpm install`.

set -uo pipefail

if [ "${AWB_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: skipped (AWB_SKIP_PREPUSH=1)"
  exit 0
fi

zero='0000000000000000000000000000000000000000'
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ -n "${local_sha:-}" ] && [ "$local_sha" != "$zero" ]; then
    has_content=1
  fi
done

if [ "$has_content" -eq 0 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Git exports GIT_DIR (and friends) into every hook. Anything the test suite spawns would
# inherit them, so a test that runs `git init` in a temp dir then commits would operate on
# THIS worktree's git dir instead and fail — 35 tests failed this way while the same suite
# passed when run directly. Drop them before handing control to build/test.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_INTERNAL_GETTEXT_SH_SCHEME

echo "pre-push: building..."
if ! pnpm build; then
  echo >&2
  echo "pre-push: build FAILED (see above). Push aborted." >&2
  echo "          Bypass with 'git push --no-verify' if intentional." >&2
  exit 1
fi

echo "pre-push: running tests..."
if ! pnpm test; then
  echo >&2
  echo "pre-push: tests FAILED (see above). Push aborted." >&2
  echo "          Bypass with 'git push --no-verify' if intentional." >&2
  exit 1
fi

echo "pre-push: build and tests green."
exit 0
