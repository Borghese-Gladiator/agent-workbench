+                    WidgetSubtype.SMS,
+                    WidgetSubtype.PUSH,
+                    WidgetSubtype.BY_CHANNEL,
+                ]
+            )
+        ]
+        service._data_service.get_dashboard_or_none.return_value = dashboard_data
+        service._data_service.get_widgets.return_value = always_visible + funnel_widgets
+
+        with patch.object(
