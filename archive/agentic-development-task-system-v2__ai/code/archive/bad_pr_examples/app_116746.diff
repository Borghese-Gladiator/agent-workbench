+"""CORE-587: delete legacy per-channel FUNNEL_SUMMARY widgets.
+
+Runs after the insert migration (#0038) and the gate flip. Deletes
+per-channel (EMAIL/SMS/PUSH) funnel summary widgets only on dashboards
+that already have a BY_CHANNEL row, so a dashboard the insert migration
+missed is left intact for a follow-up sweep.
+
+Operational: app_widget is ~37M rows. We page over distinct
+performance_dashboard_id with a keyset cursor, run RunPython with
+atomic=False so each chunk commits independently, and sleep briefly
+between chunks to ease replication pressure.
+"""
+
+from __future__ import annotations
+
+import time
+
+from django.apps.registry import Apps
+from django.db.backends.base.schema import BaseDatabaseSchemaEditor
+
+from app.db import migrations
+
+_TYPE_FUNNEL_SUMMARY = 3
+_SUBTYPE_BY_CHANNEL = 1
+_SUBTYPE_EMAIL = 4
+_SUBTYPE_SMS = 5
+_SUBTYPE_PUSH = 17
+_PER_CHANNEL_SUBTYPES = (_SUBTYPE_EMAIL, _SUBTYPE_SMS, _SUBTYPE_PUSH)
+
+_CHUNK_SIZE = 5000
+_SLEEP_BETWEEN_CHUNKS_S = 0.1
+
+
+def delete_per_channel_widgets(apps: Apps, _: BaseDatabaseSchemaEditor) -> None:
+    Widget = apps.get_model("app_custom_analytics_reports", "Widget")
+
+    # PerformanceDashboard.id is a ULID (string), so "" is a valid initial cursor.
+    cursor = ""
+    chunks = 0
+    deleted_total = 0
+
+    while True:
+        chunk_dashboard_ids = list(
+            Widget.objects.filter(
+                type=_TYPE_FUNNEL_SUMMARY,
+                subtype=_SUBTYPE_BY_CHANNEL,
+                performance_dashboard_id__gt=cursor,
+            )
+            .values_list("performance_dashboard_id", flat=True)
+            .order_by("performance_dashboard_id")
+            .distinct()[:_CHUNK_SIZE]
+        )
+        if not chunk_dashboard_ids:
+            break
+
+        deleted, _details = Widget.objects.filter(
+            type=_TYPE_FUNNEL_SUMMARY,
+            subtype__in=_PER_CHANNEL_SUBTYPES,
+            performance_dashboard_id__in=chunk_dashboard_ids,
+        ).delete()
+
+        chunks += 1
+        deleted_total += deleted
+        cursor = chunk_dashboard_ids[-1]
+        print(f"CORE-587 delete: chunk {chunks} cursor={cursor} deleted={deleted}")
+
+        time.sleep(_SLEEP_BETWEEN_CHUNKS_S)
+
+    print(
+        f"CORE-587 delete: processed {chunks} chunks, "
+        f"removed {deleted_total} per-channel funnel summary widgets"
+    )
+
+
+def noop_reverse(_apps: Apps, _: BaseDatabaseSchemaEditor) -> None:
+    # Deleted rows are intentionally retired; we don't snapshot ULID id,
+    # order, name, or details, so recreating them isn't possible. Roll back
+    # via the insert migration's reverse before this delete runs.
+    print(
+        "CORE-587 delete reverse: noop -- deleted per-channel funnel summary "
+        "widgets are not recreated"
+    )
+
+
+class Migration(migrations.Migration):
+
+    dependencies = [
+        (
+            "app_custom_analytics_reports",
+            "0038_core587_insert_funnel_summary_by_channel",
+        ),
+    ]
+
+    operations = [
+        migrations.RunPython(
+            delete_per_channel_widgets,
+            noop_reverse,
+            atomic=False,
+        ),
+    ]
