# Local-only configs (DO NOT ignore the .example template)
config/repos.yaml

# DO NOT ignore:
#   runs/        — every run's artifacts are version-controlled memory
#   worktrees/   — git refuses to nest worktrees, but the dir itself stays tracked
#   *.md         — markdown artifacts ARE the product
#   .beads/      — Beads task graph is committed so the index is reproducible
#                  at every commit (single-user workbench; revisit if team mode)
