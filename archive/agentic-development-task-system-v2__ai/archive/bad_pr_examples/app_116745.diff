+"""CORE-587: insert FUNNEL_SUMMARY/BY_CHANNEL widgets.
+
+Inserts one BY_CHANNEL row per dashboard that has a per-channel funnel
+summary widget (EMAIL/SMS/PUSH). Order = min(order) of the source rows so
+the new widget lands in the same UI slot. Legacy rows are removed in a
+follow-on migration once the gate is fully on.
+
+Operational: app_widget is ~37M rows. We page over distinct
+performance_dashboard_id with a keyset cursor, run RunPython with
+atomic=False so each chunk commits independently, and sleep briefly
+between chunks to ease replication pressure.
+"""
+
+from __future__ import annotations
+
+import time
+
+from django.apps.registry import Apps
+from django.db.backends.base.schema import BaseDatabaseSchemaEditor
+from django.db.models import Min
+
+from app.db import migrations
+
+# Stable enum values from app.custom_analytics.data_services.types.dashboards.
+# Hard-coded — data migrations should not import live application code.
+_TYPE_FUNNEL_SUMMARY = 3
+_SUBTYPE_BY_CHANNEL = 1
+_SUBTYPE_EMAIL = 4
+_SUBTYPE_SMS = 5
+_SUBTYPE_PUSH = 17
+_PER_CHANNEL_SUBTYPES = (_SUBTYPE_EMAIL, _SUBTYPE_SMS, _SUBTYPE_PUSH)
+_STATUS_LOADING = 2
+_DEFAULT_NAME = "Funnel Summary By Channel"
+
+_CHUNK_SIZE = 5000
+_SLEEP_BETWEEN_CHUNKS_S = 0.1
+
+
+def insert_by_channel_widgets(apps: Apps, _: BaseDatabaseSchemaEditor) -> None:
+    Widget = apps.get_model("app_custom_analytics_reports", "Widget")
+
+    # PerformanceDashboard.id is a ULID (string), so "" is a valid initial cursor.
+    cursor = ""
+    chunks = 0
+    inserted = 0
+    skipped = 0
+
+    while True:
+        chunk_rows = list(
+            Widget.objects.filter(
+                type=_TYPE_FUNNEL_SUMMARY,
+                subtype__in=_PER_CHANNEL_SUBTYPES,
+                performance_dashboard_id__gt=cursor,
+            )
+            .values("company_id", "performance_dashboard_id")
+            .annotate(min_order=Min("order"))
+            .order_by("performance_dashboard_id")[:_CHUNK_SIZE]
+        )
+        if not chunk_rows:
+            break
+
+        chunk_dashboard_ids = [r["performance_dashboard_id"] for r in chunk_rows]
+        already_migrated: set[str] = set(
+            Widget.objects.filter(
+                type=_TYPE_FUNNEL_SUMMARY,
+                subtype=_SUBTYPE_BY_CHANNEL,
+                performance_dashboard_id__in=chunk_dashboard_ids,
+            ).values_list("performance_dashboard_id", flat=True)
+        )
+
+        new_widgets = [
+            Widget(
+                company_id=r["company_id"],
+                performance_dashboard_id=r["performance_dashboard_id"],
+                name=_DEFAULT_NAME,
+                type=_TYPE_FUNNEL_SUMMARY,
+                subtype=_SUBTYPE_BY_CHANNEL,
+                order=r["min_order"],
+                status=_STATUS_LOADING,
+                details={},
+            )
+            for r in chunk_rows
+            if r["performance_dashboard_id"] not in already_migrated
+        ]
+        if new_widgets:
+            Widget.objects.bulk_create(new_widgets, batch_size=_CHUNK_SIZE)
+
+        chunks += 1
+        inserted += len(new_widgets)
+        skipped += len(chunk_rows) - len(new_widgets)
+        cursor = chunk_dashboard_ids[-1]
+        print(
+            f"CORE-587 insert: chunk {chunks} cursor={cursor} "
+            f"inserted={len(new_widgets)} skipped={len(chunk_rows) - len(new_widgets)}"
+        )
+
+        time.sleep(_SLEEP_BETWEEN_CHUNKS_S)
+
+    print(
+        f"CORE-587 insert: processed {chunks} chunks, "
+        f"inserted {inserted} BY_CHANNEL widgets, "
+        f"skipped {skipped} dashboards that already had one"
+    )
+
+
+def delete_by_channel_widgets(apps: Apps, _: BaseDatabaseSchemaEditor) -> None:
+    """Reverse: delete BY_CHANNEL rows on dashboards that still have a per-channel row.
+
+    Won't perfectly invert if the legacy rows have already been removed by a
+    later migration — that's expected; the reverse exists for rollback before
+    the delete migration runs.
+    """
+    Widget = apps.get_model("app_custom_analytics_reports", "Widget")
+
+    cursor = ""
+    chunks = 0
+    deleted_total = 0
+
+    while True:
+        legacy_dashboard_ids = list(
+            Widget.objects.filter(
+                type=_TYPE_FUNNEL_SUMMARY,
+                subtype__in=_PER_CHANNEL_SUBTYPES,
+                performance_dashboard_id__gt=cursor,
+            )
+            .values_list("performance_dashboard_id", flat=True)
+            .order_by("performance_dashboard_id")
+            .distinct()[:_CHUNK_SIZE]
+        )
+        if not legacy_dashboard_ids:
+            break
+
+        deleted, _details = Widget.objects.filter(
+            type=_TYPE_FUNNEL_SUMMARY,
+            subtype=_SUBTYPE_BY_CHANNEL,
+            performance_dashboard_id__in=legacy_dashboard_ids,
+        ).delete()
+
+        chunks += 1
+        deleted_total += deleted
+        cursor = legacy_dashboard_ids[-1]
+        print(
+            f"CORE-587 insert reverse: chunk {chunks} cursor={cursor} deleted={deleted}"
+        )
+
+        time.sleep(_SLEEP_BETWEEN_CHUNKS_S)
+
+    print(
+        f"CORE-587 insert reverse: processed {chunks} chunks, "
+        f"deleted {deleted_total} BY_CHANNEL widgets"
+    )
+
+
+class Migration(migrations.Migration):
+
+    dependencies = [
+        ("app_custom_analytics_reports", "0037_core481_index_together_to_indexes"),
+    ]
+
+    operations = [
+        migrations.RunPython(
+            insert_by_channel_widgets,
+            delete_by_channel_widgets,
+            atomic=False,
+        ),
+    ]
