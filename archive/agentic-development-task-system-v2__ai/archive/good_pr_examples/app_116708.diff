+    @staticmethod
+    def _filter_visible(
+        widgets: Iterable[WidgetData],
+        widget_subtype: frozenset[WidgetSubtype],
+    ) -> Iterator[WidgetData]:
+        """
+        Check widgets based on feature flag status of widget subtype
+        (currently only Funnel Summary feature flag)
+        """
+        return (
+            w
+            for w in widgets
+            if not (w.type == WidgetType.FUNNEL_SUMMARY and w.subtype in widget_subtype)
+        )
+
+    def _visible_widgets(
+        self, company_id: str, dashboard_id: str
+    ) -> Iterator[WidgetData]:
+        """Get filtered list of widgets based on feature flag status of widget subtype"""
+        widget_subtype = (
+            _FUNNEL_SUMMARY_HIDDEN_WHEN_FLAG_ON
+            if self._is_multi_channel_funnel_summary_enabled(company_id)
+            else _FUNNEL_SUMMARY_HIDDEN_WHEN_FLAG_OFF
+        )
+        return self._filter_visible(
+            self._data_service.get_widgets(company_id, dashboard_id), widget_subtype
+        )
+
+    def _get_max_visible_count(self, widgets: Iterable[WidgetData]) -> int:
+        """Max visible widget count across both funnel-summary flag states."""
+        widgets = list(widgets)
+        return max(
+            sum(
+                1
+                for _ in self._filter_visible(
+                    widgets, _FUNNEL_SUMMARY_HIDDEN_WHEN_FLAG_ON
+                )
+            ),
+            sum(
+                1
+                for _ in self._filter_visible(
+                    widgets, _FUNNEL_SUMMARY_HIDDEN_WHEN_FLAG_OFF
+                )
+            ),
+        )
+
+    def _would_exceed_widget_limit(
+        self,
+        existing_widgets: Iterable[WidgetData],
+        new_type: WidgetType,
+        new_subtype: WidgetSubtype,
+    ) -> bool:
+        """Check if adding a widget would exceed the max widget limit."""
+        widgets = list(existing_widgets)
+
+        hidden_subtype_options = (
+            _FUNNEL_SUMMARY_HIDDEN_WHEN_FLAG_ON,
+            _FUNNEL_SUMMARY_HIDDEN_WHEN_FLAG_OFF,
+        )
+
+        for hidden_subtypes in hidden_subtype_options:
+            visible_count = sum(
+                1 for _ in self._filter_visible(widgets, hidden_subtypes)
+            )
+
+            new_widget_is_hidden = (
+                new_type == WidgetType.FUNNEL_SUMMARY and new_subtype in hidden_subtypes
+            )
+
+            post_add_count = visible_count + int(not new_widget_is_hidden)
+
+            if post_add_count > self._MAX_WIDGETS_PER_DASHBOARD:
+                return True
+
+        return False
+
