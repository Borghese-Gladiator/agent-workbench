+            company_id=COMPANY_ID,
+            performance_dashboard=dashboard_model,
+            name="Campaign Performance",
+            type=WidgetType.PERFORMANCE,
+            subtype=WidgetSubtype.CAMPAIGN,
+            order=0,
+            status=WidgetStatus.COMPLETE,
+            created=utcnow().datetime,
+            updated=utcnow().datetime,
+        )
+        # Flag is OFF, so BY_CHANNEL is hidden.
+        hidden_model = Widget(
+            id="hiddenwidgetidd01",
+            company_id=COMPANY_ID,
+            performance_dashboard=dashboard_model,
+            name="Funnel Summary By Channel",
+            type=WidgetType.FUNNEL_SUMMARY,
+            subtype=WidgetSubtype.BY_CHANNEL,
+            order=1,
+            status=WidgetStatus.COMPLETE,
+            created=utcnow().datetime,
+            updated=utcnow().datetime,
+        )
+        visible = WidgetData.from_model(visible_model)
+        hidden = WidgetData.from_model(hidden_model)
+        service._data_service.get_dashboard_or_none.return_value = dashboard_data
+        service._data_service.get_widgets.return_value = [visible, hidden]
+
+        with patch.object(
+            PerformanceDashboardService,
+            "_is_multi_channel_funnel_summary_enabled",
+            return_value=False,
+        ):
+            service.trigger_dashboard_update_task(COMPANY_ID, DASHBOARD_ID)
+
+        # Only the visible widget should have its status set to LOADING.
+        service._data_service.update_widget.assert_called_once_with(
+            COMPANY_ID,
+            DASHBOARD_ID,
+            visible.widget_id,
+            status=WidgetStatus.LOADING,
+        )
