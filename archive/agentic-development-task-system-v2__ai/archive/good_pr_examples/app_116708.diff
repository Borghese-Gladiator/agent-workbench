+        self, service, dashboard_data, non_funnel_count, funnel_subtypes, expected
+    ):
+        """Returns max(visible count under flag-on, visible count under flag-off)."""
+        service._data_service.get_dashboard_or_none.return_value = dashboard_data
+        service._data_service.get_widgets.return_value = [
+            WidgetFactory.build(
+                type=WidgetType.PERFORMANCE, subtype=WidgetSubtype.CAMPAIGN, order=i
+            )
+            for i in range(non_funnel_count)
+        ] + [
+            WidgetFactory.build(
+                type=WidgetType.FUNNEL_SUMMARY,
+                subtype=subtype,
+                order=non_funnel_count + i,
+            )
+            for i, subtype in enumerate(funnel_subtypes)
+        ]
+
+        assert service.get_visible_widget_count(COMPANY_ID, DASHBOARD_ID) == expected
+
+    @patch("app.tasks.process_performance_dashboard.apply_async_or_raise_exception")
+    def test_trigger_dashboard_update_task_skips_hidden_funnel_widgets(
+        self, mock_dashboard_task, service, dashboard_data, dashboard_model
+    ):
+        """Hidden funnel-summary widgets are not iterated/enqueued when triggering updates."""
+        visible_model = Widget(
