# Agent Workbench — environment overrides.
#
# Copy to `.env` (gitignored) to override defaults. docker-compose reads it
# automatically; for native `pnpm daemon`/`pnpm web` these are also honored if
# exported into the shell.

# Daemon API port (host + in-container). Default 4417.
WORKBENCH_PORT=4417

# Web dev-server port. Default 5317.
VITE_PORT=5317

# Agent runtime CLI (claude). Only used by the `claude` per-project runtime,
# which needs the host CLI + login — see the host-CLI caveat in docker-compose.yml.
WORKBENCH_CLAUDE_BIN=claude
WORKBENCH_CLAUDE_MODEL=
