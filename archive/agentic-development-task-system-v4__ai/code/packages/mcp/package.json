{
  "name": "@workbench/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "workbench-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
